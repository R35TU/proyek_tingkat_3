rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil pengguna: izinkan read publik agar pencarian username saat login
    // dan validasi keunikan username saat registrasi dapat berjalan.
    // Pembuatan, pengubahan, dan penghapusan akun tetap dibatasi untuk sesi terautentikasi (Admin).
    match /users/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Data proyek: hanya sesi login Firebase Auth yang diizinkan.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
