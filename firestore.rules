rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil pengguna: hanya pengguna yang sudah login boleh membaca
    // (diperlukan untuk cek role saat login & daftar akun di halaman Admin).
    // Pembuatan akun baru dilakukan Admin lewat aplikasi (bukan backend).
    match /users/{uid} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Data proyek: hanya sesi login Firebase Auth yang diizinkan.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
